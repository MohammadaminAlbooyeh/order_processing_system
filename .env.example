# Database Configuration
DATABASE_URL=postgresql://ecommerce:password@postgres:5432/orders

# Redis Configuration
REDIS_URL=redis://redis:6379
# Redis URL used by worker-service (env name kept from the original Celery design)
CELERY_BROKER_URL=redis://redis:6379

# Security
# Any string works; each service derives a 256-bit HMAC key via SHA-256 of this
# value. Order API and User Service MUST share the same value for JWTs to verify.
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO

# SMTP (Email Notifications) - notification-service
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Twilio (SMS Notifications) - notification-service
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Distributed Tracing - OTLP endpoint of the Jaeger collector
OTLP_ENDPOINT=http://jaeger:4318/v1/traces
